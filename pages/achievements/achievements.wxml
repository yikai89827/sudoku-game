<!-- pages/achievements/achievements.wxml -->
<view class="container theme-{{theme}}">
  <view class="bg-decoration">
    <view class="bg-circle bg-circle-1"></view>
    <view class="bg-circle bg-circle-2"></view>
  </view>

  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navHeight}}px;">
    <view class="nav-left" style="width: {{menuWidth}}px;">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon">‹</text>
        <text class="nav-back-text">返回</text>
      </view>
    </view>
    <text class="nav-title">成就</text>
    <view class="nav-right" style="width: {{menuWidth}}px;"></view>
  </view>

  <view class="ach-summary fade-in">
    <text class="ach-count">{{unlockedCount}}</text>
    <text class="ach-total">/ {{totalCount}}</text>
  </view>

  <view class="ach-groups">
    <view class="ach-group" wx:for="{{groups}}" wx:key="name">
      <view class="group-header fade-in">
        <text class="group-name">{{item.name}}</text>
        <text class="group-count">{{item.unlocked}}/{{item.total}}</text>
      </view>
      <view class="ach-list">
        <view
          wx:for="{{item.items}}"
          wx:for-item="ach"
          wx:key="key"
          class="ach-card fade-in {{ach.unlocked ? 'ach-unlocked' : 'ach-locked'}}"
        >
          <view class="ach-icon-area" style="background: {{ach.unlocked ? 'rgba(255,215,0,0.2)' : 'rgba(255,255,255,0.05)'}}; border-color: {{ach.unlocked ? 'rgba(255,215,0,0.4)' : 'rgba(255,255,255,0.1)'}};">
            <text class="ach-icon">{{ach.unlocked ? ach.icon : '🔒'}}</text>
          </view>
          <view class="ach-info">
            <text class="ach-name">{{ach.name}}</text>
            <text class="ach-desc">{{ach.desc}}</text>
          </view>
          <view class="ach-status">
            <text class="ach-status-text" wx:if="{{ach.unlocked}}">已解锁</text>
            <text class="ach-status-text" wx:else>未解锁</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
