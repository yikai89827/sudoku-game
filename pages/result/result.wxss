/* pages/result/result.wxss */
.container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  position: relative;
  overflow: hidden;
}

.bg-decoration {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  overflow: hidden;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  filter: blur(80rpx);
  opacity: var(--circle-opacity, 0.15);
}

.bg-circle-1 { width: 400rpx; height: 400rpx; background: var(--circle-1, #667eea); top: -80rpx; left: -80rpx; }
.bg-circle-2 { width: 350rpx; height: 350rpx; background: var(--success, #43e97b); bottom: -60rpx; right: -60rpx; }
.bg-circle-3 { width: 300rpx; height: 300rpx; background: var(--circle-3, #f093fb); top: 50%; right: -100rpx; }

.result-card {
  z-index: 1;
  width: 100%;
  max-width: 600rpx;
  background: var(--card-bg, rgba(255, 255, 255, 0.08));
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  backdrop-filter: blur(20px);
  border: 1px solid var(--card-border, rgba(255, 255, 255, 0.15));
  box-shadow: 0 16rpx 48rpx var(--card-shadow, rgba(0, 0, 0, 0.4));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.result-title {
  font-size: 56rpx;
  font-weight: 800;
  background: linear-gradient(135deg, var(--success, #43e97b), #38f9d7);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 0 40rpx rgba(67, 233, 123, 0.3);
}

.result-title.fail {
  background: linear-gradient(135deg, #f5576c, var(--circle-3, #f093fb));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.result-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
  margin-top: 8rpx;
  display: block;
}

.stars-area {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.star {
  font-size: 80rpx;
}

.star-active text {
  animation: starBounce 0.6s ease both;
}

.star-active:nth-child(1) text { animation-delay: 0.2s; }
.star-active:nth-child(2) text { animation-delay: 0.4s; }
.star-active:nth-child(3) text { animation-delay: 0.6s; }

.star-inactive {
  opacity: 0.2;
  filter: grayscale(100%);
}

@keyframes starBounce {
  0% { transform: scale(0) rotate(-30deg); }
  50% { transform: scale(1.3) rotate(10deg); }
  100% { transform: scale(1) rotate(0); }
}

.stats-area {
  width: 100%;
  margin-bottom: 40rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  border-bottom: 1px solid var(--card-border-faint, rgba(255, 255, 255, 0.06));
}

.stat-row:last-child {
  border-bottom: none;
}

.stat-label {
  font-size: 28rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
}

.stat-val {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary, #fff);
}

.action-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-next {
  width: 100%;
  height: 96rpx;
  background: var(--accent-gradient, linear-gradient(135deg, #667eea, #764ba2));
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx var(--accent-shadow, rgba(118, 75, 162, 0.4));
  transition: all 0.2s ease;
}

.btn-next:active {
  transform: scale(0.97);
}

.btn-next text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--btn-text, #fff);
}

.btn-secondary {
  display: flex;
  gap: 16rpx;
}

.btn-half {
  flex: 1;
  height: 80rpx;
  background: var(--card-bg, rgba(255, 255, 255, 0.08));
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--card-border-soft, rgba(255, 255, 255, 0.1));
  transition: all 0.2s ease;
}

.btn-half:active {
  transform: scale(0.97);
  background: var(--card-bg-press, rgba(255, 255, 255, 0.15));
}

.btn-half text {
  font-size: 28rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.7));
}

.fireworks {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 2;
  pointer-events: none;
}

.firework {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  animation: firework 1.5s ease-out infinite;
}

.fw1 { left: 20%; top: 30%; background: var(--gold, #ffd700); animation-delay: 0.2s; }
.fw2 { left: 70%; top: 25%; background: var(--circle-3, #f093fb); animation-delay: 0.6s; }
.fw3 { left: 50%; top: 15%; background: var(--success, #43e97b); animation-delay: 1s; }

@keyframes firework {
  0% {
    transform: scale(0);
    opacity: 1;
    box-shadow: 0 0 0 0 currentColor;
  }
  50% {
    transform: scale(1);
    opacity: 1;
    box-shadow: 0 0 20rpx 10rpx currentColor;
  }
  100% {
    transform: scale(0.5);
    opacity: 0;
    box-shadow: 0 0 40rpx 20rpx transparent;
  }
}
