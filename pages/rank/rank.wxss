/* pages/rank/rank.wxss */
.container {
  min-height: 100vh;
  padding: 0 30rpx 60rpx;
  position: relative;
  overflow: hidden;
}

.bg-decoration {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
  opacity: var(--circle-opacity, 0.15);
}

.bg-circle-1 {
  width: 400rpx;
  height: 400rpx;
  background: var(--circle-1, #667eea);
  top: -80rpx;
  right: -80rpx;
}

.bg-circle-2 {
  width: 300rpx;
  height: 300rpx;
  background: var(--circle-2, #764ba2);
  bottom: 120rpx;
  left: -60rpx;
}

.nav-bar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: content-box;
}

.nav-left,
.nav-right {
  flex-shrink: 0;
}

.nav-back {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx 8rpx 0;
}

.nav-back-icon {
  font-size: 48rpx;
  color: var(--text-primary, #fff);
  line-height: 40rpx;
  margin-right: 4rpx;
}

.nav-back-text {
  font-size: 28rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.8));
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary, #fff);
  letter-spacing: 2rpx;
}

.rank-tip {
  position: relative;
  z-index: 1;
  margin: 24rpx 0;
  padding: 20rpx 24rpx;
  background: var(--accent-tip-bg, rgba(102, 126, 234, 0.15));
  border-radius: 16rpx;
  border: 1px solid var(--accent-tip-border, rgba(102, 126, 234, 0.25));
}

.tip-text {
  font-size: 24rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.65));
  line-height: 1.5;
}

.rank-canvas-wrap {
  position: relative;
  z-index: 1;
  margin: 0 auto;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1px solid var(--card-border-soft, rgba(255, 255, 255, 0.1));
  box-shadow: 0 8rpx 32rpx var(--card-shadow, rgba(0, 0, 0, 0.3));
}

.rank-canvas {
  display: block;
  background: var(--rank-canvas-bg, #1a1a2e);
}

.rank-footer {
  position: relative;
  z-index: 1;
  margin-top: 30rpx;
  text-align: center;
}

.footer-note {
  font-size: 22rpx;
  color: var(--text-muted, rgba(255, 255, 255, 0.35));
}
