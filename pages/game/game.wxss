/* pages/game/game.wxss */
.game-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.game-nav {
  position: relative;
  display: flex;
  align-items: center;
  padding-bottom: 40rpx;
  margin-top: 100rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
  box-sizing: border-box;
}

.nav-back, .nav-pause {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-bg, rgba(255, 255, 255, 0.08));
  border-radius: 20rpx;
  border: 1px solid var(--card-border-soft, rgba(255, 255, 255, 0.1));
  z-index: 10;
  flex-shrink: 0;
}

.nav-back:active, .nav-pause:active {
  background: var(--card-bg-press, rgba(255, 255, 255, 0.15));
  transform: scale(0.95);
}

.nav-icon {
  font-size: 40rpx;
  color: var(--text-primary, #fff);
  line-height: 1;
}

.nav-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  flex-shrink: 0;
  pointer-events: none;
}

.nav-diff {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary, #fff);
}

.nav-level {
  font-size: 22rpx;
  color: var(--text-muted, rgba(255, 255, 255, 0.4));
  margin-top: 4rpx;
}

.status-bar {
  display: flex;
  justify-content: space-around;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
}

.status-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-icon {
  font-size: 28rpx;
  opacity: 0.6;
}

.status-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary, rgba(255, 255, 255, 0.8));
}

.status-value.danger {
  color: var(--danger, #ff5252);
}

.sudoku-board {
  width: 100%;
  max-width: 660rpx;
  margin: 0 auto;
  background: var(--board-bg, rgba(255, 255, 255, 0.04));
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 8rpx 32rpx var(--card-shadow, rgba(0, 0, 0, 0.3));
  border: 2px solid var(--board-border, rgba(255, 255, 255, 0.1));
}

.board-row {
  display: flex;
}

.row-border {
  margin-bottom: 4rpx;
  border-bottom: 3rpx solid var(--accent-border, rgba(102, 126, 234, 0.5));
}

.cell {
  flex: 1;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6rpx;
  margin: 1rpx;
  position: relative;
  transition: background 0.15s ease;
  background: var(--cell-bg, rgba(255, 255, 255, 0.03));
}

.col-border {
  margin-right: 4rpx;
  border-right: 3rpx solid var(--accent-border, rgba(102, 126, 234, 0.5));
}

.cell-selected {
  background: var(--accent-fill, rgba(102, 126, 234, 0.35)) !important;
  box-shadow: 0 0 0 2rpx var(--accent-border-strong, rgba(102, 126, 234, 0.8));
}

.cell-highlight-row {
  background: var(--accent-fill-soft, rgba(102, 126, 234, 0.1));
}

.cell-highlight-col {
  background: var(--accent-fill-soft, rgba(102, 126, 234, 0.1));
}

.cell-same-number {
  background: var(--accent-fill-mid, rgba(102, 126, 234, 0.2)) !important;
}

.cell-initial {
  background: var(--cell-initial-bg, rgba(255, 255, 255, 0.06)) !important;
}

.cell-error {
  background: rgba(255, 82, 82, 0.2) !important;
  animation: shake 0.4s ease;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-4rpx); }
  75% { transform: translateX(4rpx); }
}

.cell-chain {
  background: rgba(255, 215, 0, 0.3) !important;
  animation: chainFlash 0.6s ease;
}

@keyframes chainFlash {
  0% { background: rgba(255, 215, 0, 0.6); transform: scale(1.05); }
  50% { background: rgba(255, 215, 0, 0.4); transform: scale(1.02); }
  100% { background: rgba(255, 215, 0, 0.3); transform: scale(1); }
}

.cell-value {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--cell-value, #4a90d9);
}

.initial-value {
  color: var(--cell-initial, #fff);
  font-weight: 700;
}

.error-value {
  color: var(--danger, #ff5252) !important;
  text-shadow: 0 0 10rpx rgba(255, 82, 82, 0.5);
}

.chain-value {
  color: var(--gold, #ffd700) !important;
  text-shadow: 0 0 20rpx rgba(255, 215, 0, 0.8);
}

.notes-grid {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  height: 100%;
  padding: 2rpx;
  box-sizing: border-box;
}

.note-cell {
  width: 33.33%;
  height: 33.33%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.note-text {
  font-size: 18rpx;
  color: var(--note-color, rgba(255, 255, 255, 0.35));
  font-weight: 500;
}

.loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 32rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.5));
  animation: shimmer 1.5s ease-in-out infinite;
}

.action-bar {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 20rpx 8rpx;
  max-width: 660rpx;
  margin: 0 auto;
  width: 100%;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 90rpx;
  background: var(--card-bg-soft, rgba(255, 255, 255, 0.06));
  border-radius: 16rpx;
  border: 1px solid var(--card-border-faint, rgba(255, 255, 255, 0.08));
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.92);
  background: var(--card-bg-active, rgba(255, 255, 255, 0.12));
}

.action-btn.active {
  background: var(--accent-fill-strong, rgba(102, 126, 234, 0.3));
  border-color: var(--accent-border-active, rgba(102, 126, 234, 0.6));
}

.action-btn.disabled {
  opacity: 0.3;
}

.action-icon {
  font-size: 32rpx;
  margin-bottom: 2rpx;
}

.action-label {
  font-size: 20rpx;
  color: var(--text-secondary, rgba(255, 255, 255, 0.6));
}

.number-panel {
  display: flex;
  justify-content: space-around;
  padding: 12rpx 16rpx 40rpx;
  max-width: 660rpx;
  margin: 0 auto;
  width: 100%;
}

.num-btn {
  width: 64rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-bg, rgba(255, 255, 255, 0.08));
  border-radius: 16rpx;
  border: 1px solid var(--card-border-soft, rgba(255, 255, 255, 0.1));
  transition: all 0.15s ease;
}

.num-btn:active {
  transform: scale(0.92);
  background: var(--accent-fill, rgba(102, 126, 234, 0.4));
}

.num-btn.num-active {
  background: var(--accent-fill, rgba(102, 126, 234, 0.35));
  border-color: var(--accent-border-strong, rgba(102, 126, 234, 0.7));
}

.num-btn.num-note-mode {
  border-style: dashed;
}

.num-text {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--num-text, #fff);
}

.pause-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-bg, rgba(0, 0, 0, 0.85));
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pause-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: popIn 0.3s ease;
}

.pause-icon {
  font-size: 100rpx;
  color: var(--pause-icon, rgba(255, 255, 255, 0.6));
  margin-bottom: 20rpx;
}

.pause-text {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary, #fff);
  margin-bottom: 40rpx;
}

.resume-btn {
  padding: 24rpx 80rpx;
  background: var(--accent-gradient, linear-gradient(135deg, #667eea, #764ba2));
  border-radius: 50rpx;
  color: var(--btn-text, #fff);
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx var(--accent-shadow, rgba(118, 75, 162, 0.4));
}

.chain-effect-overlay {
  position: fixed;
  top: 30%;
  left: 0;
  right: 0;
  z-index: 50;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.chain-bonus-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: chainPop 1.5s ease forwards;
}

@keyframes chainPop {
  0% { opacity: 0; transform: scale(0.5) translateY(0); }
  20% { opacity: 1; transform: scale(1.2) translateY(-20rpx); }
  40% { transform: scale(1) translateY(-10rpx); }
  80% { opacity: 1; transform: scale(1) translateY(-30rpx); }
  100% { opacity: 0; transform: scale(1) translateY(-60rpx); }
}

.chain-bonus-text {
  font-size: 52rpx;
  font-weight: 800;
  background: linear-gradient(135deg, var(--gold, #ffd700), #ffa500);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 0 30rpx rgba(255, 215, 0, 0.5);
  letter-spacing: 4rpx;
}

.chain-bonus-value {
  font-size: 72rpx;
  font-weight: 800;
  color: var(--gold, #ffd700);
  text-shadow: 0 0 40rpx rgba(255, 215, 0, 0.8);
  margin-top: 8rpx;
}

.chain-bonus-mult {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff6b6b;
  margin-top: 4rpx;
}

.chain-bonus-extra {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--success, #43e97b);
  margin-top: 8rpx;
  text-shadow: 0 0 20rpx rgba(67, 233, 123, 0.5);
  animation: pulseGreen 0.5s ease infinite alternate;
}

@keyframes pulseGreen {
  from { transform: scale(1); }
  to { transform: scale(1.1); }
}

.chain-bonus-display.continuous {
  animation: chainPopContinuous 1.5s ease forwards;
}

@keyframes chainPopContinuous {
  0% { opacity: 0; transform: scale(0.5) translateY(0); }
  20% { opacity: 1; transform: scale(1.2) translateY(-20rpx); }
  40% { transform: scale(1) translateY(-10rpx); }
  80% { opacity: 1; transform: scale(1) translateY(-30rpx); }
  100% { opacity: 0; transform: scale(1) translateY(-60rpx); }
}

.win-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--overlay-bg-soft, rgba(0, 0, 0, 0.7));
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
}

.win-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: popIn 0.5s ease;
}

.win-text {
  font-size: 64rpx;
  font-weight: 800;
  background: linear-gradient(135deg, var(--success, #43e97b), #38f9d7);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 0 40rpx rgba(67, 233, 123, 0.5);
}

.win-stars {
  margin-top: 20rpx;
}

.star {
  font-size: 80rpx;
  animation: starBounce 0.5s ease;
  animation-delay: 0.3s;
}

@keyframes starBounce {
  0% { transform: scale(0); }
  60% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.mission-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 8rpx 4rpx;
  z-index: 1;
}

.mission-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  background: var(--card-bg, rgba(255, 255, 255, 0.08));
  border-radius: 12rpx;
}

.mission-text {
  font-size: 22rpx;
  line-height: 1;
  color: var(--text-secondary, rgba(255, 255, 255, 0.55));
}

.mission-item.done {
  background: var(--success-fill, rgba(67, 233, 123, 0.15));
}

.mission-item.done .mission-text {
  color: var(--success, #43e97b);
}

.blitz-actions {
  display: flex;
  justify-content: center;
  padding: 8rpx 0 4rpx;
  z-index: 1;
}

.blitz-btn {
  padding: 10rpx 28rpx;
  border-radius: 24rpx;
  background: var(--gold-soft, rgba(255, 215, 0, 0.15));
  border: 1px solid var(--gold-border, rgba(255, 215, 0, 0.35));
}

.blitz-btn text {
  font-size: 24rpx;
  color: var(--gold, #ffd700);
}

.blitz-btn.disabled {
  opacity: 0.45;
}

.time-float {
  position: fixed;
  top: 28%;
  left: 0;
  right: 0;
  z-index: 60;
  display: flex;
  justify-content: center;
  pointer-events: none;
  animation: timeFloatUp 0.9s ease forwards;
}

.time-float text {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--gold, #ffd700);
  text-shadow: 0 0 20rpx rgba(255, 215, 0, 0.6);
}

@keyframes timeFloatUp {
  0% { opacity: 0; transform: translateY(20rpx); }
  30% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(-40rpx); }
}
