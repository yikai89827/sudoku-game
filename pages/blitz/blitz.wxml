<!-- pages/blitz/blitz.wxml -->
<view class="container theme-{{theme}}">
  <view class="bg-decoration">
    <view class="bg-circle bg-circle-1"></view>
    <view class="bg-circle bg-circle-2"></view>
  </view>

  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navHeight}}px;">
    <view class="nav-left" style="width: {{menuWidth}}px;">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-back-icon">‹</text>
        <text class="nav-back-text">返回</text>
      </view>
    </view>
    <text class="nav-title">闪电挑战</text>
    <view class="nav-right" style="width: {{menuWidth}}px;"></view>
  </view>

  <view class="tip fade-in">
    <text class="tip-text">选择初始时间。填对 +2 秒，连锁 +5 秒，连击再 +3 秒；填错 -5 秒。每局可看视频延时一次、复活一次。</text>
  </view>

  <view class="option-list fade-in">
    <view
      class="option-card"
      wx:for="{{options}}"
      wx:key="minutes"
      data-seconds="{{item.seconds}}"
      bindtap="onSelect"
    >
      <text class="option-icon">⚡</text>
      <view class="option-info">
        <text class="option-label">{{item.label}}</text>
        <text class="option-desc">倒计时 {{item.seconds}} 秒</text>
      </view>
      <text class="option-arrow">›</text>
    </view>
  </view>
</view>
